#cloud-config
# Generated by proxmox-lab-terraform for ${hostname} (role: ${role})
hostname: ${hostname}
fqdn: ${hostname}.${domain}
manage_etc_hosts: true
timezone: ${timezone}

users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{ for k in ssh_keys ~}
      - ${k}
%{ endfor ~}

ssh_pwauth: false
disable_root: true
package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent
  - curl
  - ca-certificates
  - git
  - htop
  - python3

runcmd:
  - systemctl enable --now qemu-guest-agent
%{ if role == "docker" || role == "netcockpit" ~}
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker ${admin_user}
%{ endif ~}
%{ if role == "netcockpit" ~}
  - git clone https://github.com/B2ZO0/netcockpit.git /opt/netcockpit
  - cd /opt/netcockpit && umask 077 && ./setup.sh --yes > /var/log/netcockpit-setup.log 2>&1
%{ endif ~}
%{ if role != "netcockpit" && netcockpit_host != "" ~}
  - echo "NetCockpit of this lab: http://${netcockpit_host}:8088" > /etc/motd
%{ endif ~}

final_message: "${hostname} is ready after $UPTIME seconds"
